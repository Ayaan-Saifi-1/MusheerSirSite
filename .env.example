# ==============================================================================
# Environment Configuration Template: Dr. Musheer Ahmad Academic Portfolio
# Copy this file to .env and configure for local development or production deployment.
# ==============================================================================

# Security
DJANGO_SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,musheerahmad.jmi.ac.in

# Database (PostgreSQL for Production, SQLite for Local Development)
DATABASE_URL=postgres://musheer_admin:secure_db_pass_2026@db:5432/musheer_portfolio
POSTGRES_DB=musheer_portfolio
POSTGRES_USER=musheer_admin
POSTGRES_PASSWORD=secure_db_pass_2026

# Email Configuration (for Student Application Notifications & Inquiries)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=mahmad9@jmi.ac.in
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Dr. Musheer Ahmad Portfolio <mahmad9@jmi.ac.in>

# Frontend API URL (leave empty for same-origin proxy in production)
VITE_API_URL=http://127.0.0.1:8000/api/v1
